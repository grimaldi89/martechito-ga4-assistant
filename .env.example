OPENAI_API_KEY=openai_api_key          #Open AI API key to use
QDRANT_API_KEY=qdrant                  #Qdrant API key to use
QDRANT_URL=qdrant_url.qdrant.io        #Qdrant URL to use
QDRANT_PORT=6333                       #Qdrant default port. Default: 6333
COLLECTION_NAME=collection_name_chosen #Qdrant collection name
EMBEDDING_MODEL=text-embedding-3-large #Open AI Embedding model to use. Default: text-embedding-3-large
MODEL=gpt-4o                           #Open AI model to use. Default: gpt-4o

# Only needed when running scripts/ingest_ga4_docs/ingest.py to (re)populate the Qdrant collection
CHUNK_SIZE=3072                        #Chunk size of document splits before embedding. Default: 3072
CHUNK_OVERLAP=500                      #Chunk overlap size of document splits. Default: 500
