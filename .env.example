MODEL=gpt-5.5 #Open AI model to use. Must support the Responses API web_search tool (e.g. gpt-5.5, gpt-4.1). Default: gpt-5.5

# Optional: the app owner's own key, used to cover each visitor's free tier
# (up to SESSION_TOKEN_LIMIT tokens per browser session). Leave unset to
# require every visitor to bring their own key from the start.
OPENAI_API_KEY=openai_api_key
SESSION_TOKEN_LIMIT=20000 #Tokens (input+output) a session can use on OPENAI_API_KEY before requiring the visitor's own key. Default: 20000
